{
  # Consumer flake generated by nixcfg's generate-consumer-flake.sh.
  # Structure from numtide/blueprint (home-manager standalone template):
  # hosts/<host>/users/<user>.nix maps to homeConfigurations."<user>@<host>"
  # (under legacyPackages.<system>.homeConfigurations).
  #
  # Inputs are pinned to the same revs as the nixcfg lock so the consumer
  # resolves identically to the internal definition; bump together.
  inputs = {
    # gnome-workstation targets Linux; pin the consumer to x86_64-linux
    systems.url = "github:nix-systems/x86_64-linux";

    nixpkgs.url = "github:NixOS/nixpkgs/__NIXPKGS_REV__";

    nixpkgs-unstable.url = "github:NixOS/nixpkgs/__NIXPKGS_UNSTABLE_REV__";

    blueprint = {
      url = "github:numtide/blueprint";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    home-manager = {
      url = "github:nix-community/home-manager/__HOME_MANAGER_REV__";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    devshells = {
      url = "github:tcarrio/devshells";
      inputs.nixpkgs.follows = "nixpkgs-unstable";
    };

    # Local path for validation against the working tree; swap for
    # github:tcarrio/nixcfg when consuming for real.
    nixcfg = {
      url = "path:__NIXCFG_PATH__";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.nixpkgs-unstable.follows = "nixpkgs-unstable";
      inputs.home-manager.follows = "home-manager";
    };
  };

  outputs = inputs: inputs.blueprint { inherit inputs; };
}
