# Functional equivalent of nixcfg's thomascarrio@greybox, expressed as an
# external consumer of the nixcfg library. Everything the internal host
# draws from mixins (user profile, systems layer, host file, GNOME personal
# dconf) is inlined here — the library provides all structure via
# oxc.profiles.gnome-workstation and the oxc.* module set.
#
# Override points for a different user: git identity, ssh config, apt
# repositories/keys, and anything personal below.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  # Anthropic release signing key, shared by the claude-code and
  # claude-desktop apt repositories. Defined inline — deterministic
  # definition, dearmored at build time.
  # Verified fingerprint (https://code.claude.com/docs/en/setup):
  #   31DD DE24 DDFA B679 F42D 7BD2 BAA9 29FF 1A7E CACE
  anthropicKeyInfo = {
    text = ''
      -----BEGIN PGP PUBLIC KEY BLOCK-----

      mQINBGnK73ABEACnbytJXkjweYrwIr0aLEFRlH+C0nF44KxFc7gQmJ6PjSPMGZAD
      dxZcaixU7zZl8WxEpVO0wLmIH8cf2zGOdyuZg1Yaugk1vHb2b8WBhAGCQJdPgB8W
